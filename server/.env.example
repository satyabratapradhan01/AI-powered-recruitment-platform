# =========================================================
# HireFlow AI - Backend Environment Variables
# =========================================================

NODE_ENV=production
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas connection string for production)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/job_tracker?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here

# Default Platform Admin Credentials (seeded on initial launch)
ADMIN_EMAIL=admin@platform.com
ADMIN_PASSWORD=Admin@123456

# AI Feature Keys (Gemini & Groq)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# SMTP Email Configuration (e.g. Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password
EMAIL_FROM=no-reply@hireflow.com

# Cloudflare R2 / S3 Object Storage (For Candidate Resumes)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=resume-storage
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=
