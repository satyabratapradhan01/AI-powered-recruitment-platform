# =========================================================
# Client Environment Variables (For Separate Deployment)
# =========================================================
# In local development:
# VITE_API_URL=http://localhost:5000/api
#
# In production on Vercel (Project Settings -> Environment Variables):
# Set this to your deployed Backend URL (from Vercel or Render):
VITE_API_URL=https://your-backend.vercel.app/api
